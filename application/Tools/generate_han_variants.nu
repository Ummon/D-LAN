# Generate the table used to fold the traditional Chinese characters to their simplified form when searching,
# see 'Common::HanVariants'.
# The table comes from the dictionary 'TSCharacters.txt' of OpenCC (https://github.com/BYVoid/OpenCC), Apache License 2.0.
# Each of its lines is a traditional character followed by its simplified forms: the first one, the most common, is kept.
#
# Usage, from this directory:
#    nu generate_han_variants.nu                  # Download the dictionary.
#    nu generate_han_variants.nu TSCharacters.txt # Use a local copy of the dictionary.

const DICTIONARY_URL = "https://raw.githubusercontent.com/BYVoid/OpenCC/master/data/dictionary/TSCharacters.txt"
const OUTPUT_FILE = "../Common/HanVariantsData.h"
const NB_PAIRS_PER_LINE = 6

# The code point of a string made of a single character.
def code-point []: string -> int {
    let bytes = $in | into binary
    let value = $bytes | into int --endian big
    let continuation = {|n| $value | bits shr (6 * $n + 2 * $n) | bits and 0x3F | bits shl (6 * $n) }
    match ($bytes | bytes length) {
        1 => $value
        2 => (($value | bits shr 8 | bits and 0x1F | bits shl 6) + (do $continuation 0))
        3 => (($value | bits shr 16 | bits and 0x0F | bits shl 12) + (do $continuation 1) + (do $continuation 0))
        4 => (($value | bits shr 24 | bits and 0x07 | bits shl 18) + (do $continuation 2) + (do $continuation 1) + (do $continuation 0))
    }
}

def to-hex []: int -> string {
    $in | format number --no-prefix | get upperhex | fill --alignment right --character "0" --width 4 | "0x" + $in
}

def main [dictionary?: path] {
    let content = if $dictionary == null { http get --raw $DICTIONARY_URL | decode utf-8 } else { open --raw $dictionary | decode utf-8 }

    let pairs = $content
        | lines
        | where {|line| $line != "" and not ($line starts-with "#") }
        | each {|line|
            let fields = $line | split row "\t"
            { traditional: $fields.0, simplified: ($fields.1 | split row " " | first) }
        }
        | where {|pair| $pair.traditional != $pair.simplified }

    # A simplified form may itself have a simplified form: the table gives the last one, folding twice changes nothing.
    mut resolved_pairs = $pairs
    loop {
        let next_forms = $resolved_pairs | rename key next
        let resolved = $resolved_pairs
            | join --left $next_forms simplified key
            | each {|pair| { traditional: $pair.traditional, simplified: ($pair.next? | default $pair.simplified) } }
        if $resolved == $resolved_pairs { break }
        $resolved_pairs = $resolved
    }

    let lines = $resolved_pairs
        | each {|pair| { traditional: ($pair.traditional | code-point), simplified: ($pair.simplified | code-point) } }
        | sort-by traditional
        | each {|pair| $"{ ($pair.traditional | to-hex), ($pair.simplified | to-hex) }," }
        | chunks $NB_PAIRS_PER_LINE
        | each {|chunk| "      " + ($chunk | str join " ") }

    [
        "// Generated by 'Tools/generate_han_variants.nu', don't edit it."
        "// The data come from the dictionary 'TSCharacters.txt' of OpenCC (https://github.com/BYVoid/OpenCC), Apache License 2.0."
        ""
        "#pragma once"
        ""
        "namespace Common"
        "{"
        "   struct HanVariant"
        "   {"
        "      char32_t traditional;"
        "      char32_t simplified;"
        "   };"
        ""
        "   /**"
        "     * Sorted by 'traditional'. A simplified character is never a traditional one of another pair."
        "     */"
        "   constexpr HanVariant TRADITIONAL_TO_SIMPLIFIED[] = {"
        ...$lines
        "   };"
        "}"
        ""
    ] | str join "\n" | save --force $OUTPUT_FILE

    print $"($pairs | length) pairs written in ($OUTPUT_FILE)"
}
